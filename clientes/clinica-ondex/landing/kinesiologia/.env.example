# Copiar a .env y completar SOLO la primera línea. El .env no se sube al repositorio.
#
# OJO: todo lo que empieza con VITE_ queda visible en el bundle que llega al navegador.
# Nunca poner acá una API key privada de GoHighLevel. La URL del Inbound Webhook sí
# puede ir: sólo permite crear contactos, no leer datos.

# ⬇️ LO ÚNICO QUE FALTA
# GHL → Automatización → Workflows → Trigger "Inbound Webhook" → copiar la URL
VITE_GHL_WEBHOOK_URL=

# ✅ Ya confirmados — no hay que tocarlos
VITE_WHATSAPP_NUMERO=+56952296611
VITE_META_PIXEL_ID=1354537603365442

# Identificador para la etiqueta (sin tildes ni espacios)
VITE_LANDING_ORIGEN=kinesiologia
# Nombre legible, es lo que ve la clínica en la ficha del contacto
VITE_LANDING_NOMBRE=Kinesiología
