# Copiar a .env y rellenar. El archivo .env NO se sube al repositorio.
#
# OJO: todo lo que empieza con VITE_ queda visible en el bundle que llega al
# navegador. Nunca poner acá una API key privada de GoHighLevel. La URL del
# Inbound Webhook sí puede ir: sólo permite crear contactos, no leer datos.

# Automatización → Workflows → Trigger "Inbound Webhook" → copiar la URL
VITE_GHL_WEBHOOK_URL=

# Número de WhatsApp de la clínica, formato internacional
VITE_WHATSAPP_NUMERO=+56912345678

# ID del píxel de Meta. Si queda vacío, el píxel simplemente no carga.
VITE_META_PIXEL_ID=
VITE_LANDING_ORIGEN=kinesiologia
